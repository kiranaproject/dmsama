[Unit]
Description=Samarinda Display Manager
Documentation=man:dmsama(8)
After=systemd-user-sessions.service plymouth-quit-wait.service
After=getty@tty7.service
Conflicts=getty@tty7.service
RequiresMountsFor=/projects
After=projects.mount

[Service]
ExecStart=/usr/bin/dmsama
Restart=always
RestartSec=1s

[Install]
Alias=display-manager.service
WantedBy=graphical.target
